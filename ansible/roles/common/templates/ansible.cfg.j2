#  ansible.cfg ({{ app_name }})

[defaults]
interpreter_python = auto_silent
inventory = inventory
playbook_dir = playbooks
remote_user = ansible 
roles_path = roles
vault_password_file = ~/.vault_pass

[privilege_escalation]
become_method=sudo

[inventory]
enable_plugins=host_list, yaml, script, auto, ini, toml

#  End of settings  #
